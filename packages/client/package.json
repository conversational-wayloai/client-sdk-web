{
  "name": "@waylovoice/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "llms.txt",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "lint": "eslint --cache --fix .",
    "format": "prettier --write --log-level=warn --ignore-path ../../.prettierignore \"**/*.{yml,json,md}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "validate": "pnpm lint && pnpm typecheck && pnpm test:coverage"
  },
  "dependencies": {
    "livekit-client": "^2.22.3"
  },
  "devDependencies": {
    "@gilbarbara/eslint-config": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "jsdom": "^30.1.3",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
