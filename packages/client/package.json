{
  "name": "@waylovoice/client",
  "version": "0.1.1",
  "description": "Browser SDK for voice calls with a Waylo voice agent",
  "keywords": [
    "waylo",
    "voice",
    "ai",
    "agent",
    "webrtc",
    "sdk"
  ],
  "homepage": "https://conversational-wayloai.github.io/developer-docs/",
  "bugs": "https://github.com/conversational-wayloai/client-sdk-web/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conversational-wayloai/client-sdk-web.git",
    "directory": "packages/client"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "llms.txt",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "cp ../../README.md ../../LICENSE .",
    "lint": "eslint --cache --fix .",
    "format": "prettier --write --log-level=warn --ignore-path ../../.prettierignore \"**/*.{yml,json,md}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "validate": "pnpm lint && pnpm typecheck && pnpm test:coverage"
  },
  "dependencies": {
    "livekit-client": "^2.22.3"
  },
  "devDependencies": {
    "@gilbarbara/eslint-config": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "jsdom": "^30.1.3",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
