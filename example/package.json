{
  "name": "@waylovoice/example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --format=esm --target=es2022 --minify --outfile=dist/app.js",
    "dev": "esbuild src/main.ts --bundle --format=esm --target=es2022 --sourcemap=inline --outfile=dist/app.js --watch",
    "lint": "eslint --cache --fix .",
    "typecheck": "tsc -p tsconfig.json",
    "validate": "pnpm lint",
    "start": "node --env-file=.env server.mjs"
  },
  "dependencies": {
    "@waylovoice/client": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  }
}
