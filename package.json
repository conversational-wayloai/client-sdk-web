{
  "name": "client-sdk-web",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@gilbarbara/eslint-config": "catalog:",
    "eslint": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "catalog:",
    "repo-tools": "^0.3.1",
    "typescript": "catalog:"
  },
  "scripts": {
    "build": "pnpm -r build",
